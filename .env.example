# Copy to .env.local and fill in. Never commit the real file.

# Random string for signing sessions. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (Settings > Developer settings > OAuth Apps)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# A fine-grained GitHub token with no repository permissions (public read only).
# Used for scans by visitors who aren't signed in, so they get 5,000 requests/hour instead of 60.
GITHUB_TOKEN=
